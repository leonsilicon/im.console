{
  "name": "im.console",
  "version": "0.2.0",
  "description": "import.meta.console — console.* with file:line:col baked into every call",
  "keywords": [
    "console",
    "import.meta",
    "logger",
    "babel-plugin",
    "react-native"
  ],
  "license": "MIT",
  "repository": "leonsilicon/im.console",
  "author": {
    "name": "Leon Si",
    "email": "leon@leonsilicon.com"
  },
  "files": [
    "dist",
    "src/types"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "lint": "lintroll",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    "./package.json": "./package.json",
    "./types": {
      "types": "./src/types/index.d.ts",
      "default": "./src/types/index.d.ts"
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin/index.d.mts",
        "default": "./dist/plugin/index.mjs"
      },
      "require": {
        "types": "./dist/plugin/index.d.cts",
        "default": "./dist/plugin/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "require": {
        "types": "./dist/runtime/index.d.cts",
        "default": "./dist/runtime/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "types": ["./src/types/index.d.ts"],
      "plugin": ["./dist/plugin/index.d.mts"],
      "runtime": ["./dist/runtime/index.d.ts"]
    }
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.10.0",
    "@types/babel__core": "^7.20.5"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@types/babel__core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.15.29",
    "clean-pkg-json": "^1.2.0",
    "lintroll": "^1.8.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.2"
  },
  "packageManager": "pnpm@11.1.2"
}
